# ── Secrets / runtime data ──
config.yaml
data/
*.db
*.db-wal
*.db-shm
*.log
.env

# Local LLM models (GGUF files, several GB each — never committed).
models/
*.gguf

# ── Python ──
__pycache__/
*.pyc
.venv/
venv/

# ── Généré au build (version baking) ──
src/_version.py
src/_update_keys.py

# ── PyInstaller build artefacts ──
build/
build_spike/
dist/
*.spec.bak

# ── IDE / OS ──
.cursor/
.vscode/
.idea/
.vs/
node_modules/
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/
frontend/.playwright-data/
*.lnk
Thumbs.db
.DS_Store

# pnpm content-addressable store (frontend deps cache)
.pnpm-store/

# Local run configurations for the preview harness (machine-specific paths)
.claude/
.venv311/

# Update-signing private keys. scripts/new_update_key.py writes one here by
# default; it must never reach a commit, and `git add -A` does not ask.
*.private
update-signing-key*
