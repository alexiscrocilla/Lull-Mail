{
  "name": "lullmail-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:multi": "playwright test -c playwright.multi.config.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc -p jsconfig.json",
    "css:build": "tailwindcss -c tailwind.config.js -i tailwind-input.css -o tailwind.css --minify",
    "css:check": "node scripts/check-generated-css.mjs",
    "vendor:check": "node scripts/check-vendor.mjs",
    "quality": "node --test tests/*.test.mjs && tsc -p jsconfig.json && node scripts/check-generated-css.mjs && node scripts/check-vendor.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2"
  }
}
